# Copy to .env and change the password:  cp .env.example .env
# Password: only letters and digits (no $ @ : / # — they break Docker variables and the DB URL)
POSTGRES_DB=tutinguard
POSTGRES_USER=tutinguard
POSTGRES_PASSWORD=change-me-please

# Port of the app on this machine. Locally: http://localhost:8000
HTTP_PORT=8000
# 127.0.0.1 = reachable only from this machine (use with Caddy on a server).
# 0.0.0.0   = open to the network (server without HTTPS, e.g. for a quick demo).
BACKEND_BIND=127.0.0.1

# Server with HTTPS: domain name that points to the server's IP (used by Caddy)
DOMAIN=tutinguard.example.kz

# Optional secret for the simulator WebSocket. If set, open the simulator as /sim/?token=<value>
INGEST_TOKEN=

# Demo accounts operator / responsible / technician / admin use this password. CHANGE IT on a public server.
DEMO_PASSWORD=demo

# Rules
OFFLINE_SECONDS=30      # device silent this long -> "нет связи" + repair task
ESCALATE_SECONDS=60     # confirmed fire not accepted this long -> sirens + DEMO call card
READINGS_KEEP_HOURS=24
AUTO_DISPATCH=confirmed   # DEMO fire brigade: confirmed (as soon as the fire is confirmed) | escalation | off  (no real call is ever sent)
BRIGADE_ETA_S=45          # simulated travel time of the brigade, seconds of simulation time

# City monitoring centre: optional local LLM (Ollama) for fire-protocol drafts and questions.
# Example: install Ollama on the host, `ollama pull qwen2.5:7b-instruct`, then:
# OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct

# Data quality (backend/app/quality.py): seconds a detector is "warming up" after its link came back (its alarms need confirmation)
WARMUP_S=120
# Server-side re-query: a single detector holding the alarm this long confirms the fire (ESP32 stand and other devices without a panel)
REQUERY_S=60
