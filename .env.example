# Copy to .env and change the password:  cp .env.example .env
# Password: only letters and digits (no $ @ : / # — they break Docker variables and the DB URL)
POSTGRES_DB=tutinguard
POSTGRES_USER=tutinguard
POSTGRES_PASSWORD=change-me-please

# Port of the app on this machine. Locally: http://localhost:8000
HTTP_PORT=8000
# 127.0.0.1 = reachable only from this machine (use with Caddy on a server).
# 0.0.0.0   = open to the network (server without HTTPS, e.g. for a quick demo).
BACKEND_BIND=127.0.0.1

# Server with HTTPS: domain name that points to the server's IP (used by Caddy)
DOMAIN=tutinguard.example.kz

# Optional secret for the simulator WebSocket. If set, open the simulator as /sim/?token=<value>
INGEST_TOKEN=

# Rules
OFFLINE_SECONDS=30      # device silent this long -> "нет связи" + repair task
ESCALATE_SECONDS=60     # confirmed fire not accepted this long -> sirens + DEMO call card
READINGS_KEEP_HOURS=24
